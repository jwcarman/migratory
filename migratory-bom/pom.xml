<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.jwcarman.migratory</groupId>
        <artifactId>migratory-parent</artifactId>
        <version>0.2.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>migratory-bom</artifactId>
    <packaging>pom</packaging>

    <name>Migratory - BOM</name>
    <description>Bill of Materials for Migratory: version alignment for consumers</description>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.jwcarman.migratory</groupId>
                <artifactId>migratory-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jwcarman.migratory</groupId>
                <artifactId>migratory-autoconfigure</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jwcarman.migratory</groupId>
                <artifactId>migratory-spring-boot-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!--
        Flattened on the way out, and only this module is.
        Importing a BOM pulls in its *effective* dependencyManagement, after inheritance, and
        migratory-parent imports spring-boot-dependencies for its own build. Published as-is, this
        BOM would re-export all of Spring Boot's managed versions. bom mode writes the pom that is
        installed and deployed without the parent and with only the dependencyManagement declared
        here.
    -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <configuration>
                    <flattenMode>bom</flattenMode>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten-clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
